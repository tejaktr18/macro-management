# Copy to envs/<name>.env (e.g. envs/isengard.env) and edit.
# envs/*.env is git-ignored except this example, so account details never
# land in the public repo.

# Named AWS CLI profile that has credentials for the target account.
AWS_PROFILE=isengard

# Lambda Web Functions launched in us-east-1, us-east-2, us-west-2,
# ap-northeast-1, eu-west-1. us-west-2 (Oregon) is closest to Seattle.
AWS_REGION=us-west-2

# Prefix for stack, function and table names. Keep it the same per account.
APP_NAME=protocol

# Bedrock inference profile. Enable model access in the Bedrock console first.
MODEL_ID=us.anthropic.claude-sonnet-5-5

# Where the app is served from (CORS). Comma-separate to add more.
ALLOWED_ORIGINS=https://tejaktr18.github.io

# Photo/text estimates per user per day (0 = unlimited). Optional.
DAILY_ANALYZE_LIMIT=40
